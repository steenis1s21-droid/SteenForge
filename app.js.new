function getCurrentLanguage() { return localStorage.getItem('language') || 'sv'; }
function setLanguage(lang) { localStorage.setItem('language', lang); }
function updateCommonStaticContent() {}
function getUI() { return { actionOpenWeb: 'Öppna webbversion', actionDownloadFile: 'Ladda ner fil' }; }
function getLocalizedContent(app) { return { name: app.name, tagline: app.tagline }; }
function getAppPlatforms(app) { return [app.platform]; }
function buildReleaseNotesMarkup(notes) { return notes.map((note) => `<li>${note.title}</li>`).join(''); }
function formatDate(value) { return value; }
function updateLanguageSelector(select) { if (select) select.value = getCurrentLanguage(); }
function setLanguage(lang) { localStorage.setItem('language', lang); window.location.reload(); }
function getAppData() { return { apps, getCurrentLanguage, setLanguage, updateCommonStaticContent, getUI, getLocalizedContent, getAppPlatforms, buildReleaseNotesMarkup, formatDate, updateLanguageSelector }; }
window.SteenForge = getAppData();
